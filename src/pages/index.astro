import Layout from '../layouts/Layout.astro';

const workSlots = [
  'f853d19b', '843928c0', '2ba3dcb6', 'c4f79a35', '0ec5e0ac',
  'b0dc0e46', '6f8c8fd4', '29c2cf12', '77bea49a', 'e9fb74ba',
].map((id, i) => ({ id, title: `Project ${String(i + 1).padStart(2, '0')}` }));

const frames = [
  { title: 'Generative art poster concept', w: 1024, h: 1024 },
  { title: 'Generative art poster concept', w: 760, h: 1024 },
  { title: 'Generative art poster concept', w: 802, h: 1024 },
  { title: 'My first FOTD on FWA ♥ (2012)', w: 768, h: 1024 },
  { title: 'Young me discovering the beauty of <s>Grand Canyon</s> Tetris (1997)', w: 600, h: 600 },
  { title: 'Me abusing of remote work (2005)', w: 768, h: 1024 },
  { title: 'Roaaaar!', w: 576, h: 1024 },
  { title: 'Early age (2006) desk setup', w: 640, h: 480 },
  { title: '2016 desk setup', w: 1024, h: 576 },
  { title: '2020 desk setup', w: 1024, h: 576 },
  { title: 'Waaark Creative Robots', w: 1440, h: 1440 },
  { title: '2011 portfolio', w: 1024, h: 768 },
  { title: '2014 portfolio (767)', w: 1024, h: 768 },
  { title: '2017 portfolio (never released)', w: 1024, h: 768 },
  { title: '2021 portfolio', w: 1024, h: 768 },
  { title: 'Legos ♥', w: 768, h: 1024 },
];

// a-separator 二进制段（源站 01-hero.html 结构：码组+条纹，blank 恒在第 8 位；SSR 静态生成）
const sep = (groups: number) => `<span class="a__triangle"></span><span class="a__binaries">${
  Array.from({ length: groups }, () => {
    const bits = [...Array.from({ length: 7 }, () => Math.round(Math.random())), ' '];
    return `<span class="a__code js-code">${bits.map((b) => b === ' '
      ? '<span class="a__char a__char--blank js-char"> </span>'
      : `<span class="a__char a__char--${b} js-char">${b}</span>`).join('')}</span><span class="a__stripes"></span>`;
  }).join('')}</span><span class="a__triangle"></span>`;
