---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SPIKE — Creative Developer" description="Creative developer portfolio: animation-driven, high-impact websites. GSAP · WebGL · Motion.">
  <div class="site-wrapper js-site-wrapper">
    <!-- P1 临时填充：撑出可滚动高度供验收，P2 移除 -->
    <div class="p1-filler" aria-hidden="true"></div>
  </div>

  <div class="site-mount js-mount" aria-hidden="true"></div>
  <div class="site-contrast-mask js-contrast-mask" aria-hidden="true"></div>

  <div class="site-scrollbar js-scrollbar" aria-hidden="true">
    <div class="site-scrollbar__track"></div>
    <div class="site-scrollbar__thumb js-scrollbar-thumb"></div>
  </div>

  <script>
    import '../scripts/main.ts';
  </script>
</Layout>
