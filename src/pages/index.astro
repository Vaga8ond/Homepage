---
import Layout from '../layouts/Layout.astro';

const projects = [
  { title: 'Nebula', tag: 'WebGL / Scroll', video: '/videos/project-01.mp4', key: 'k3va' },
  { title: 'Studio Flux', tag: 'Brand / Motion', video: '/videos/project-02.mp4', key: 'd7qz' },
  { title: 'Orbit UI', tag: 'Design System', video: '/videos/project-03.mp4', key: 'n9rk' },
  { title: 'Kinetic', tag: 'GSAP / Physics', video: '/videos/project-04.mp4', key: 'x2pl' },
  { title: 'Terminal 9', tag: 'Creative Dev', video: '/videos/project-05.mp4', key: 'w8sc' },
  { title: 'Waveform', tag: 'Audio / Canvas', video: '/videos/project-06.mp4', key: 'm4tb' },
  { title: 'Mono Club', tag: 'Brutalist', video: '/videos/project-07.mp4', key: 'v6hy' },
  { title: 'Grid Walk', tag: 'Layout / CSS', video: '/videos/project-08.mp4', key: 'j1fd' },
  { title: 'Pulse', tag: 'Interactive', video: '/videos/project-09.mp4', key: 'z5ng' },
  { title: 'Afterglow', tag: 'Shader', video: '/videos/project-10.mp4', key: 'r0ty' },
];
---
<Layout title="SPIKE — Creative Developer" description="Creative developer portfolio: animation-driven, high-impact websites. GSAP · WebGL · Motion.">
  <!-- Preloader -->
  <div class="preloader js-preloader">
    <div class="preloader__border preloader__border--top"></div>
    <div class="preloader__border preloader__border--left"></div>
    <div class="preloader__border preloader__border--right"></div>
    <div class="preloader__logo">
      <span class="line line--v"></span><span class="line line--v"></span><span class="line line--v"></span>
      <span class="line line--h"></span><span class="line line--h"></span>
    </div>
    <div class="preloader__label">SPIKE — LOADING PORTFOLIO v1.0</div>
  </div>

  <div class="site-wrapper js-site-wrapper">
    <div class="js-mount" style="opacity:0">
      <!-- Head -->
      <header class="site-head" data-intersect>
        <div class="site-head__container">
          <div class="sb-logo">
            <a href="#top" aria-label="Back to top">
              <svg class="js-logo" width="280" height="280" viewBox="0 0 280 280" fill="none" xmlns="http://www.w3.org/2000/svg" role="img">
                <text x="140" y="196" text-anchor="middle" font-family="Anton, sans-serif" font-weight="400" font-size="168" fill="currentColor">SP</text>
              </svg>
              <span class="u-sr-only">Spike</span>
            </a>
          </div>
          <div class="sb-console" role="presentation">
            <div class="sb-console__inner js-console"></div>
          </div>
          <nav class="sb-menu" aria-label="Main">
            <ul class="sb__list">
              <li class="sb__item js-menu-item"><a href="#about" class="js-menu-link"><span class="sb__text">About</span></a></li>
              <li class="sb__item js-menu-item"><a href="#work" class="js-menu-link"><span class="sb__text">Work</span></a></li>
              <li class="sb__item js-menu-item"><a href="#contact" class="js-menu-link"><span class="sb__text">Contact</span></a></li>
            </ul>
          </nav>
          <ul class="sb-socials">
            <li class="sb__item">
              <a href="https://codepen.io" target="_blank" rel="noopener">
                <span class="sb__icon sb__icon--codepen" style="--path: path('M19.3184 6.01751L10.4517 0.105976C10.3477 0.0365379 10.2254 -0.000518799 10.1002 -0.000518799C9.97513 -0.000518799 9.85282 0.0365379 9.74874 0.105976L0.882076 6.01751C0.795245 6.07529 0.724029 6.15362 0.674752 6.24555C0.625475 6.33747 0.599663 6.44014 0.599609 6.54444V12.456C0.599609 12.6675 0.706009 12.8651 0.882076 12.9829L9.74874 18.8944C9.85269 18.9636 9.97476 19.0005 10.0996 19.0005C10.2245 19.0005 10.3465 18.9636 10.4505 18.8944L19.3171 12.9829C19.404 12.9251 19.4752 12.8468 19.5245 12.7549C19.5737 12.6629 19.5996 12.5603 19.5996 12.456V6.54444C19.5996 6.44014 19.5737 6.33747 19.5245 6.24555C19.4752 6.15362 19.404 6.07529 19.3171 6.01751H19.3184ZM10.1009 11.6934L6.80881 9.49958L10.1009 7.30571L13.3929 9.49958L10.1009 11.6934ZM10.7342 6.20498V1.81598L17.8263 6.54318L14.5342 8.73704L10.7342 6.20371V6.20498ZM9.46754 6.20498L5.66754 8.73831L2.37548 6.54444L9.46754 1.81724V6.20498ZM4.52628 9.49958L1.86754 11.2716V7.72751L4.52628 9.49958ZM5.66754 10.2608L9.46754 12.7942V17.1832L2.37548 12.456L5.66754 10.2608ZM10.7342 12.7942L14.5342 10.2608L17.8263 12.4547L10.7342 17.1819V12.7942ZM15.6755 9.49958L18.3342 7.72751V11.2716L15.6755 9.49958Z')"></span>
                <span class="u-sr-only">Follow me on CodePen</span>
              </a>
            </li>
            <li class="sb__item">
              <a href="https://linkedin.com" target="_blank" rel="noopener">
                <span class="sb__icon sb__icon--linkedin" style="--path: path('M1.13025 14.9839H3.93671V4.6H1.13025V14.9839ZM2.53348 0.0161285C1.598 0.0161285 0.849609 0.764516 0.849609 1.7C0.849609 2.63548 1.598 3.38387 2.53348 3.38387C3.46896 3.38387 4.21735 2.63548 4.21735 1.7C4.21735 0.764516 3.46896 0.0161285 2.53348 0.0161285ZM8.70767 6.19032V4.6H5.90122V14.9839H8.70767V9.65161C8.70767 6.65806 12.5432 6.47097 12.5432 9.65161V14.9839H15.3496V8.62258C15.3496 3.57097 10.0174 3.75806 8.70767 6.19032Z')"></span>
                <span class="u-sr-only">Follow me on LinkedIn</span>
              </a>
            </li>
          </ul>
          <button class="sb-contrast js-contrast" type="button">
            <span class="sb__icon" style="--path: path('M10.0996 20C8.71628 20 7.41628 19.7373 6.19961 19.212C4.98294 18.6867 3.92461 17.9743 3.02461 17.075C2.12461 16.1757 1.41228 15.1173 0.887611 13.9C0.362944 12.6827 0.100277 11.3827 0.0996106 10C0.098944 8.61733 0.361611 7.31733 0.887611 6.1C1.41361 4.88267 2.12594 3.82433 3.02461 2.925C3.92328 2.02567 4.98161 1.31333 6.19961 0.788C7.41761 0.262667 8.71761 0 10.0996 0C11.4816 0 12.7816 0.262667 13.9996 0.788C15.2176 1.31333 16.2759 2.02567 17.1746 2.925C18.0733 3.82433 18.7859 4.88267 19.3126 6.1C19.8393 7.31733 20.1016 8.61733 20.0996 10C20.0976 11.3827 19.8349 12.6827 19.3116 13.9C18.7883 15.1173 18.0759 16.1757 17.1746 17.075C16.2733 17.9743 15.2149 18.687 13.9996 19.213C12.7843 19.739 11.4843 20.0013 10.0996 20ZM11.0996 17.925C13.0829 17.675 14.7456 16.804 16.0876 15.312C17.4296 13.82 18.1003 12.0493 18.0996 10C18.0989 7.95067 17.4279 6.18 16.0866 4.688C14.7453 3.196 13.0829 2.325 11.0996 2.075V17.925Z')"></span>
            <span class="u-sr-only">Change contrast</span>
          </button>
          <aside class="sb-availability">
            <p>
              <span class="sb__line"><span class="sb__text">Coding globally from Earth.</span></span>
              <span class="sb__line"><span class="sb__text">Available for freelance work →</span> <a href="mailto:hello@spike.dev" class="sb__link">Hire me</a></span>
            </p>
          </aside>
          <a href="mailto:hello@spike.dev" class="sb-qr-code js-qr-code" title="Contact me!">
            <img src="/qr-placeholder.svg" alt="QR Code" width="72" height="72" />
          </a>
        </div>
      </header>

      <!-- Hero -->
      <section class="s-hero" data-intersect id="top">
        <x-waves class="s__waves" data-intersect>
          <svg class="js-svg" xmlns="http://www.w3.org/2000/svg"></svg>
        </x-waves>
        <div class="s-hero__content js-content">
          <x-separator class="s-hero__binary style--primary js-sep-item" data-intersect></x-separator>
          <h1 class="s-hero__title">
            <span class="js-word">Creative</span>
            <svg class="s-hero__star js-star" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M24 2c2.2 13 7 17.8 20 20-13 2.2-17.8 7-20 20-2.2-13-7-17.8-20-20 13-2.2 17.8-7 20-20z" fill="currentColor"></path>
            </svg>
            <span class="js-word">Developer</span>
          </h1>
          <x-separator class="s-hero__binary style--primary js-sep-item" data-intersect></x-separator>
        </div>
      </section>

      <x-separator class="style--secondary s__separator" data-intersect></x-separator>

      <!-- About -->
      <section class="s-about" id="about" data-intersect>
        <svg class="s-about__svg js-grid" xmlns="http://www.w3.org/2000/svg">
          <path class="js-path" d=""></path>
        </svg>
        <canvas class="s-about__canvas js-canvas"></canvas>
        <div class="s-about__inner js-inner">
          <span class="s-about__label">About</span>
          <h2 class="s-about__title">Less noise,<br />more motion.</h2>
          <p class="s-about__text">
            Creative developer crafting animation-driven, high-impact websites.
            I partner with designers to turn brutalist grids, physics and
            scroll choreography into interfaces people actually remember.
          </p>
          <div class="s-about__awards">
            <div class="s-about__award js-award"><strong>15+</strong><span>Years shipping for the web</span><span class="a-year">— since 2010</span></div>
            <div class="s-about__award js-award"><strong>140+</strong><span>Projects launched worldwide</span><span class="a-year">— and counting</span></div>
            <div class="s-about__award js-award"><strong>×3</strong><span>Site of the Day — placeholder</span><span class="a-year">2024</span></div>
            <div class="s-about__award js-award"><strong>FWA</strong><span>Of the Day — placeholder</span><span class="a-year">2025</span></div>
            <div class="s-about__award js-award"><strong>CSSDA</strong><span>Website of the Day — placeholder</span><span class="a-year">2026</span></div>
          </div>
        </div>
      </section>

      <x-separator class="style--secondary s__separator" data-intersect></x-separator>

      <!-- Work -->
      <section class="s-work" id="work" data-intersect>
        <div class="s-work__container js-container">
          <canvas class="s-work__canvas js-canvas"></canvas>
          <div class="s-work__scene js-scene">
            <h2 class="s-work__title" aria-hidden="true">
              <span class="js-letter-src">W</span><span class="js-letter-src">O</span><span class="js-letter-src">R</span><span class="js-letter-src">K</span>
            </h2>
            {projects.map((p, i) => (
              <x-work progress="1">
                <div class="x-work__inner">
                  <a href="#" target="_blank" rel="noopener" aria-label={`${p.title} — ${p.tag}`}>
                    <video class="x-work__video js-video" data-src={p.video} loop muted playsinline width="1082" height="636" preload="none"></video>
                    <div class="x-work__caption">
                      <span class="x-work__caption-text">{p.title} — {p.tag}</span>
                      <span class="x-work__caption-key">#{p.key}-{String(i).padStart(4, '0')}/{projects.length}</span>
                    </div>
                  </a>
                </div>
              </x-work>
            ))}
          </div>
          <div class="s-work__mask js-mask">
            <svg class="js-mask-svg" xmlns="http://www.w3.org/2000/svg">
              <path class="mask__outer js-mask-path-outer" d=""></path>
              <path class="mask__lines js-mask-path-lines" d=""></path>
              <path class="mask__inner js-mask-path-inner" d=""></path>
            </svg>
          </div>
          <div class="s-work__ruler js-ruler" aria-hidden="true"></div>
        </div>
      </section>

      <!-- Playground -->
      <section class="s-play" id="play" data-intersect>
        <svg class="s-play__svg js-svg" xmlns="http://www.w3.org/2000/svg">
          <path class="js-lines-path" d=""></path>
        </svg>
        <div class="js-ruler" hidden></div>
        <div class="s-play__inner">
          <span class="s-play__label">My way of working</span>
          <div class="s-play__catcher js-catcher">
            <span class="catcher--distorted">Play</span>
            <span class="catcher--normal">Ship it</span>
          </div>
          <p class="s-play__hint">Grab the cards. Throw them around. They always come back.</p>
        </div>
        <div class="s-play__smiley js-smiley" aria-hidden="true">
          <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
            <circle cx="24" cy="24" r="22" fill="currentColor" opacity=".18"/>
            <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="17" cy="20" r="2.6" fill="currentColor"/><circle cx="31" cy="20" r="2.6" fill="currentColor"/>
            <path d="M14 29q10 9 20 0" stroke="currentColor" stroke-width="2.6" fill="none" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="s-play__objects js-objects">
          <div class="p-obj"><span>Design</span><small>systems first</small></div>
          <div class="p-obj"><span>Code</span><small>vanilla & fast</small></div>
          <div class="p-obj"><span>Motion</span><small>60fps or nothing</small></div>
          <div class="p-obj"><span>Test</span><small>break it early</small></div>
          <div class="p-obj"><span>Ship</span><small>on friday, sorry</small></div>
          <div class="p-obj"><span>Play</span><small>seriously</small></div>
          <div class="p-obj"><span>Debug</span><small>with love</small></div>
        </div>
      </section>

      <!-- CTA -->
      <section class="s-cta" id="contact" data-intersect>
        <div class="s-cta__grid js-grid">
          <svg class="js-grid-svg" xmlns="http://www.w3.org/2000/svg"><path class="js-grid-path" d=""></path></svg>
        </div>
        <div class="s-cta__inner js-container">
          <div class="s-cta__hover js-hover">
            <a class="s-cta__button js-cta" href="mailto:hello@spike.dev">
              <span class="js-button-text">Get in<br />touch<em>hello@spike.dev</em></span>
            </a>
          </div>
        </div>
        <div class="s-cta__links">
          <a href="mailto:hello@spike.dev">Email</a>
          <a href="https://github.com" target="_blank" rel="noopener">GitHub ↗</a>
          <a href="https://x.com" target="_blank" rel="noopener">X / Twitter ↗</a>
          <a href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href="#top">Back to top ↑</a>
        </div>
        <div class="s-cta__foot">
          <span>©2026 SPIKE — Built with Astro · GSAP · Lenis</span>
          <span>No frameworks were harmed</span>
        </div>
      </section>
    </div>
  </div>

  <div class="site-contrast-mask js-contrast-mask"></div>
  <div class="site-scrollbar"><div class="site-scrollbar__thumb js-thumb"></div></div>

  <script>
    import '../scripts/main';
  </script>
</Layout>
